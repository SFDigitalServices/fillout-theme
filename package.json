{
  "name": "@sfgov/fillout",
  "version": "0.1.0",
  "scripts": {
    "build": "run-s build:css build:extension",
    "build:extension": "tsx extension/scripts/build.ts",
    "build:css": "postcss theme/sfgov.css -o dist/theme-sfgov.css",
    "prepublish": "npm run build:css",
    "test": "jest",
    "watch": "nodemon -w src -w extension/src -w exension/scripts --ext 'css,js*,ts*' --exec 'npm run build'"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/postcss-header": "^2.0.4",
    "@types/postcss-import": "^14.0.3",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.23",
    "postcss-cli": "^12.0.0",
    "postcss-header": "^3.0.3",
    "postcss-import": "^16.1.1",
    "postcss-load-config": "^6.0.1",
    "postcss-nested": "^7.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}